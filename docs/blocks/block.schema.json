{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Corkbored block v1", "type": "object", "required": ["id", "name", "kind", "version", "licence", "aspects", "duration", "variables", "fonts", "assets", "beats", "safe_areas"],
"properties": {
"id": {"type": "string", "pattern": "^[a-z0-9_][a-z0-9_-]*$"},
"name": {"type": "string", "minLength": 1},
"kind": {"enum": ["intro", "outro", "chapter", "sponsor", "test", "segment"]},
"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
"licence": {"type": "string", "minLength": 1},
"aspects": {"type": "object", "minProperties": 1, "properties": {"16:9": {"type": "string", "pattern": "^[a-zA-Z0-9_/-]+\\.html$"}, "9:16": {"type": "string", "pattern": "^[a-zA-Z0-9_/-]+\\.html$"}, "1:1": {"type": "string", "pattern": "^[a-zA-Z0-9_/-]+\\.html$"}}, "additionalProperties": false},
"duration": {"type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["fixed", "range", "from_words"]}, "seconds": {"type": "number", "exclusiveMinimum": 0}, "default": {"type": "number", "exclusiveMinimum": 0}, "min": {"type": "number", "exclusiveMinimum": 0}, "max": {"type": "number", "exclusiveMinimum": 0}, "words_per_minute": {"type": "number", "exclusiveMinimum": 0}, "variable": {"type": "string"}}},
"variables": {"type": "object", "additionalProperties": {"type": "object", "required": ["type", "default"], "properties": {"type": {"enum": ["text", "number", "colour", "image", "clip", "table", "enum"]}, "default": {}, "max_length": {"type": "integer", "minimum": 0}, "min": {"type": "number"}, "max": {"type": "number"}, "choices": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
"fonts": {"type": "array", "items": {"type": "string", "pattern": "^/fonts/[^.][^/]*\\.(ttf|otf|woff2?)$"}},
"assets": {"type": "array", "items": {"type": "string", "minLength": 1}},
"beats": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
"safe_areas": {"type": "object", "required": ["title", "action"], "properties": {"title": {"type": "number", "minimum": 0, "maximum": 0.5}, "action": {"type": "number", "minimum": 0, "maximum": 0.5}}}
}}
