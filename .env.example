# Copy to .env and fill in what you have. Everything here is optional:
# Wikimedia Commons, the Library of Congress and the Met need no keys, and the
# models run through your local `claude` CLI (your Claude subscription).

# --- stock photo + video libraries -----------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# For the "reaction gif" option on the picture search — free, from
# developers.giphy.com. Deliberately never part of the automatic archive
# search; see app/reactions.py for why. Rights are not cleared by using this.
GIPHY_API_KEY=

# --- archives ---------------------------------------------------------------
# https://api.repo.nypl.org/ (free, instant)
NYPL_TOKEN=

# --- research -----------------------------------------------------------------
# A local SearXNG instance the script writer searches before writing a word —
# no key, it's your own instance. `docker compose -f docker-compose.searxng.yml
# up -d` starts one. "" (the default) skips research: the writer falls back to
# hedging what it isn't sure of, same as before this existed.
SEARXNG_URL=

# --- Storyblocks (paid; stays disabled unless both are set) ------------------
STORYBLOCKS_PUBLIC_KEY=
STORYBLOCKS_SECRET_KEY=
STORYBLOCKS_PROJECT_ID=
STORYBLOCKS_USER_ID=

# --- publishing ---------------------------------------------------------------
# A Google Cloud "Desktop app" OAuth client, for uploading a rendered video
# straight to YouTube from the render tab. "" (the default) just hides that
# panel — download the render and upload it through Studio instead. See the
# README's "Publishing to YouTube" section for the Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- models -----------------------------------------------------------------
# Aliases, not api ids — opus writes, sonnet does the fiddly bits. Both
# backends below understand them.
VB_MODEL_SCRIPT=opus
VB_MODEL_UTILITY=sonnet

# How hard it thinks — low, medium, high, xhigh, max. The same scale on both
# the CLI (--effort) and the API (output_config.effort), so one setting
# drives either backend. Blank leaves it at the backend's own default (high).
# YOUSLOP_EFFORT=high
# CLAUDE_BIN=/usr/local/bin/claude

# --- reaching Claude ---------------------------------------------------------
# Two ways in. "cli" shells out to a logged-in Claude Code CLI, billed to your
# subscription — the only option before this existed. "api" calls the
# Anthropic API directly with a key, for a machine that doesn't have Claude
# Code. "auto" (the default) uses the CLI when one is on PATH, the key
# otherwise — leave both blank to get that.
# YOUSLOP_LLM_BACKEND=auto
ANTHROPIC_API_KEY=

# A third option: a fully local model via Ollama (https://ollama.com), no
# account, no key, nothing leaving the machine — the same promise Kokoro makes
# for narration, extended to script-writing. Noticeably lower quality than
# Claude, so it is never picked by "auto" — only YOUSLOP_LLM_BACKEND=ollama
# selects it, deliberately.
# YOUSLOP_LLM_BACKEND=ollama
# YOUSLOP_OLLAMA_URL=http://127.0.0.1:11434
# YOUSLOP_OLLAMA_MODEL=qwen2.5:7b-instruct

# --- etiquette --------------------------------------------------------------
# Wikimedia asks that automated clients identify themselves with a contact.
VB_USER_AGENT=youslop/1.0 (you@example.com)
